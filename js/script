document.addEventListener('DOMContentLoaded', function() {
    
    // 1. Manejo y validación del formulario de contacto
    const formulario = document.getElementById('form-contacto') || document.querySelector('form');
    
    if (formulario) {
        formulario.addEventListener('submit', function(e) {
            // Evita que la página intente recargarse o enviar un POST al servidor
            e.preventDefault();
            
            // Obtener valores
            const nombre = document.getElementById('nombre').value.trim();
            const correo = document.getElementById('correo').value.trim();
            const asunto = document.getElementById('asunto').value.trim();
            const mensaje = document.getElementById('mensaje').value.trim();
            
            // Validación de campos vacíos
            if (nombre === '' || correo === '' || asunto === '' || mensaje === '') {
                alert('Por favor, llene todos los campos del formulario.');
                return;
            }
            
            // Mensaje de éxito sin cambiar de página
            alert('¡Gracias!' + nombre + '! Tu mensaje ha sido recibido.');
            formulario.reset();
        });
    }

    // 2. Control del menú hamburguesa en dispositivos móviles (Accesible)
    const menuToggle = document.querySelector('.menu-toggle');
    const menu = document.querySelector('.menu');

    if (menuToggle && menu) {
        menuToggle.addEventListener('click', function() {
            // Alternar la clase visual para mostrar u ocultar el menú
            menu.classList.toggle('is-active');
            
            // Actualizar el estado de accesibilidad aria-expanded
            const isExpanded = menu.classList.contains('is-active');
            menuToggle.setAttribute('aria-expanded', isExpanded);
            
            // Cambiar dinámicamente la etiqueta accesible del botón
            if (isExpanded) {
                menuToggle.setAttribute('aria-label', 'Cerrar menú de navegación');
            } else {
                menuToggle.setAttribute('aria-label', 'Abrir menú de navegación');
            }
        });

        // Cerrar el menú automáticamente al hacer clic en cualquier enlace en vista móvil
        const enlacesMenuMovil = document.querySelectorAll('.barra-nav .menu a');
        enlacesMenuMovil.forEach(function(enlace) {
            enlace.addEventListener('click', function() {
                if (window.innerWidth <= 768) {
                    menu.classList.remove('is-active');
                    menuToggle.setAttribute('aria-expanded', 'false');
                    menuToggle.setAttribute('aria-label', 'Abrir menú de navegación');
                }
            });
        });
    }

    // 3. Estilo activo en los enlaces del menú al hacer scroll
    const secciones = document.querySelectorAll('main section');
    const enlacesMenu = document.querySelectorAll('.barra-nav .menu a');

    window.addEventListener('scroll', function() {
        let seccionActual = '';

        secciones.forEach(function(seccion) {
            const seccionTop = seccion.offsetTop - 120;
            const seccionAltura = seccion.offsetHeight;

            if (window.scrollY >= seccionTop && window.scrollY < seccionTop + seccionAltura) {
                seccionActual = seccion.getAttribute('id');
            }
        });

        enlacesMenu.forEach(function(enlace) {
            enlace.style.color = '';
            if (enlace.getAttribute('href') === '#' + seccionActual) {
                enlace.style.color = '#0077b6';
            }
        });
    });

});